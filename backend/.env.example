# EchoBridge AI Environment Configuration
# Copy this file to .env:
# cp .env.example .env

# [Optional] OpenAI API Key
# Used for advanced LLM nuance, context-based pronoun resolution, and personalized reply generation.
# NOTE: If this key is omitted or has insufficient credits, EchoBridge AI gracefully 
# falls back to its built-in Semantic Intent Engine and Neural Translation automatically!
OPENAI_API_KEY=your_openai_api_key_here

